
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>My Portfolio</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">My Portfolio</a>
            <a class="btn btn-primary" href="#contact">
                Contact
            </a>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="container text-center py-5">
        <h1>Hello, I am a Student</h1>
        <p>Welcome to my portfolio website.</p>
        <a href="#projects" class="btn btn-primary">
            View Projects
        </a>
    </section>

    <!-- Projects -->
    <section id="projects" class="container py-4">
        <h2 class="text-center mb-4">My Projects</h2>

        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card p-3 h-100">
                    <h4>HTML Project</h4>
                    <p>A simple webpage using HTML.</p>
                    <button class="btn btn-success">
                        View
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card p-3 h-100">
                    <h4>CSS Project</h4>
                    <p>A styled webpage using CSS.</p>
                    <button class="btn btn-success">
                        View
                    </button>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card p-3 h-100">
                    <h4>Web Project</h4>
                    <p>A responsive website design.</p>
                    <button class="btn btn-success">
                        View
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="container text-center py-5">
        <h2>Contact Me</h2>
        <p>Email: student@example.com</p>
        <a href="mailto:student@example.com"
           class="btn btn-primary">
            Send Email
        </a>
    </section>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center p-3">
        © 2026 My Portfolio
    </footer>

</body>
</html>
